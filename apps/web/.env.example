# Database
DATABASE_URL=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Мост (сервер водной доставки, internal): URL и Bearer-токен
BOT_API_URL=http://127.0.0.1:8001
BOT_API_TOKEN=

# Онлайн-оплата ЮKassa: fake | test | live
YOOKASSA_MODE=fake
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Ставка НДС (vat_code): 1 = «Без НДС»
YOOKASSA_VAT_CODE=1
# Система налогообложения (taxation_system_code): 2 = УСН «Доходы»
YOOKASSA_TAXATION_CODE=2

# Optional SMTP for email verification. If omitted, verification links are loaded to console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@aquaflow.local
