# Database
DATABASE_URL=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Telegram Bot API integration
# URL where water_delivery_bot FastAPI is running (internal, used server-side)
BOT_API_URL=http://127.0.0.1:8001
# User or admin token from water_delivery_bot api_tokens table
BOT_API_TOKEN=

# Telegram Bot token used for Login Widget hash verification (server-side only)
TELEGRAM_BOT_TOKEN=7364853748:AAHT7gLe8oMbbB1SvPzCbnIidbHxdpycAuc

# Telegram bot username (without @) for Login Widget. Required for the widget to render.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=your_bot_username

# Show "Login with Telegram" button on /login (public flag)
NEXT_PUBLIC_SHOW_TELEGRAM_LOGIN=true

# Optional SMTP for email verification. If omitted, verification links are logged to console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@aquaflow.local
