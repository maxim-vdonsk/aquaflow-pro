{
  "name": "aquaflow-pro",
  "version": "0.1.0",
  "private": true,
  "description": "Production-ready water delivery platform",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @aquaflow/database generate",
    "db:migrate": "pnpm --filter @aquaflow/database migrate",
    "db:seed": "pnpm --filter @aquaflow/database seed",
    "db:studio": "pnpm --filter @aquaflow/database studio"
  },
  "devDependencies": {
    "turbo": "^2.0.6",
    "typescript": "^5.5.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.9.0"
}
