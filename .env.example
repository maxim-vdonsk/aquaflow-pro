# Database
# POSTGRES_PASSWORD is read by docker-compose (db service) via ${POSTGRES_PASSWORD}.
# DATABASE_URL must use the same password and point at `db:5432` inside the compose network.
POSTGRES_PASSWORD=change_me_to_random
DATABASE_URL=postgresql://aquaflow:change_me_to_random@db:5432/aquaflow

# Redis
REDIS_URL=redis://localhost:6379

# Better Auth
BETTER_AUTH_SECRET=change_me_to_random_32_chars
BETTER_AUTH_URL=http://localhost:3000

# YooMoney webhook (optional)
YOOMONEY_SECRET=change_me
YOOMONEY_SHOP_ID=change_me

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=AquaFlow
